{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*"],
  // The Playwright output folders hold bundled report JS, which tsconfig.tests.json's allowJs would check.
  "exclude": ["node_modules", "dist", "build", "coverage", "tests/e2e/test-results", "tests/e2e/playwright-report"]
}