# The image installs deps and builds its output, so host copies of them stay out of the context.
node_modules
dist
coverage

.git
.gitignore
.github
.vscode
.idea

# Local config and secrets must never reach an image layer.
.env
.env.*
settings.json
*.local.json
.claude

# The runtime reads no docs.
*.md
!README.md

.DS_Store
Thumbs.db
